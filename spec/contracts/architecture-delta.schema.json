{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sos://schema/architecture-delta",
  "type": "object",
  "required": ["affected_artifacts","preserved_invariants"],
  "properties": {
    "affected_artifacts": {"type": "array","items":{"type":"string"}},
    "added": {"type":"array","items":{"type":"string"}},
    "removed": {"type":"array","items":{"type":"string"}},
    "modified": {"type":"array","items":{"type":"string"}},
    "preserved_invariants": {"type":"array","items":{"type":"string"}},
    "boundary_changes": {"type":"array","items":{"type":"string"}},
    "rationale_ref": {"type":["string","null"]},
    "work_order": {"type":"string"}
  },
  "additionalProperties": false
}
