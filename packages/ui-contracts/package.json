{
  "name": "@sos-2/ui-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "SOS 2.0 view-model contracts: typed projections of domain records for human display (mission, system state, reconciliation, evidence, candidates, assurance, experiments, ASK, rollback, packages, history, meta state), every consequential view-model carrying an upstream/downstream rationale chain of typed spine trace links plus evidence refs (Work Order W11).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@sos-2/architecture": "workspace:*",
    "@sos-2/ask": "workspace:*",
    "@sos-2/assurance": "workspace:*",
    "@sos-2/authority": "workspace:*",
    "@sos-2/conformance": "workspace:*",
    "@sos-2/decision": "workspace:*",
    "@sos-2/evidence": "workspace:*",
    "@sos-2/experiments": "workspace:*",
    "@sos-2/mission": "workspace:*",
    "@sos-2/promotion": "workspace:*",
    "@sos-2/provenance": "workspace:*",
    "@sos-2/registry": "workspace:*",
    "@sos-2/recovery-control": "workspace:*",
    "@sos-2/semantic-spine": "workspace:*",
    "@sos-2/system-state": "workspace:*"
  },
  "devDependencies": {
    "@sos-2/packages": "workspace:*",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
