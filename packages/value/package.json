{
  "name": "@sos-2/value",
  "version": "0.1.0",
  "private": true,
  "description": "SOS 2.0 Value Model: economic objectives, budgets, incentives, opportunities and typed constraints, deterministically subordinate to Mission (spec/architecture.md sections 3, 5, 18).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@sos-2/semantic-spine": "workspace:*"
  },
  "devDependencies": {
    "@sos-2/mission": "workspace:*",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
