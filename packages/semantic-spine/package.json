{
  "name": "@sos-2/semantic-spine",
  "version": "0.1.0",
  "private": true,
  "description": "SOS 2.0 Semantic Spine: identity minting, artifact envelope lifecycle, typed trace links, canonical serialization, Architecture Delta and conformance classification.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@sos-2/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "fast-check": "^3.23.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
